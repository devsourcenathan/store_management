# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# IMPORTANT: Copy this file to .env.production and fill in the real values
# NEVER commit .env.production to git!

# ==========================================
# DATABASE
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_HERE
POSTGRES_DB=stock_management

# ==========================================
# JWT SECRETS
# ==========================================
# Generate secure random strings for these:
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_KEY
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# AWS S3 (Optional - for image uploads)
# ==========================================
# Leave empty if not using S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ==========================================
# SYNC SETTINGS
# ==========================================
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_STRATEGY=last-write-wins
