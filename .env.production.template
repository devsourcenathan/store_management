# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ==========================================
# Copier ce fichier en .env.production et remplir les vraies valeurs.
# IMPORTANT : Ne jamais committer .env.production dans git !
# Dans Dokploy : coller ces variables dans l'onglet "Environment" du projet.

# ==========================================
# DOMAINES (Dokploy / Traefik)
# ==========================================
FRONTEND_DOMAIN=stock.tondomain.com
BACKEND_DOMAIN=stockapi.tondomain.com

# ==========================================
# DATABASE
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_HERE
POSTGRES_DB=stock_management

# ==========================================
# JWT SECRETS
# ==========================================
# Générer avec : openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_KEY
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# CORS
# ==========================================
CORS_ORIGIN=https://stock.tondomain.com

# ==========================================
# FRONTEND (URL publique de l'API — injectée à la build)
# ==========================================
VITE_API_URL=https://stockapi.tondomain.com/api

# ==========================================
# AWS S3 (Optionnel — uploads d'images)
# ==========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ==========================================
# EMAILS
# ==========================================
ENABLE_EMAILS=true
MAIL_PROVIDER=resend
MAIL_FALLBACK_ENABLED=true
MAIL_FALLBACK_PROVIDER=ses

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tondomain.com
RESEND_FROM_NAME=Stock Management

# AWS SES (fallback)
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
AWS_SES_FROM_EMAIL=noreply@tondomain.com
AWS_SES_FROM_NAME=Stock Management

# ==========================================
# MONITORING
# ==========================================
# Sentry DSN (laisser vide pour désactiver)
SENTRY_DSN=

# ==========================================
# SYNC SETTINGS
# ==========================================
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_STRATEGY=last-write-wins
