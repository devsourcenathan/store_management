# ============================================
# Backend .env pour le nouvel EC2
# ============================================
# Copier ce fichier vers le serveur EC2
# et le renommer en .env
# IMPORTANT: Remplacer les placeholders par les vraies valeurs

# Environment
NODE_ENV=production

# Server
PORT=3000

# Database (Neon)
DATABASE_URL="postgresql://NEON_USER:NEON_PASSWORD@NEON_HOST:5432/NEON_DB?sslmode=require"
DIRECT_URL="postgresql://NEON_USER:NEON_PASSWORD@NEON_HOST_DIRECT:5432/NEON_DB?sslmode=require"

# JWT
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_THIS_TO_ANOTHER_RANDOM_SECRET_KEY
JWT_EXPIRATION=8h
JWT_REFRESH_EXPIRATION=7d

# AWS SES Region
AWS_REGION=eu-north-1

# Cloudflare R2 (Images)
CLOUDFLARE_R2_ACCOUNT_ID=CHANGE_THIS
CLOUDFLARE_R2_ACCESS_KEY_ID=CHANGE_THIS
CLOUDFLARE_R2_SECRET_ACCESS_KEY=CHANGE_THIS
CLOUDFLARE_R2_BUCKET_NAME=CHANGE_THIS
CLOUDFLARE_R2_PUBLIC_URL=CHANGE_THIS

# DynamoDB (Audit Logs)
DYNAMODB_TABLE_NAME=AuditLogs
AUDIT_STORAGE_TYPE=DYNAMODB

# Mail Provider Selection
MAIL_PROVIDER=resend
MAIL_FALLBACK_ENABLED=true
MAIL_FALLBACK_PROVIDER=ses

# Amazon SES
AWS_SES_FROM_EMAIL=stock@sekuu.com
AWS_SES_FROM_NAME=Store Management
AWS_SES_SMTP_USERNAME=CHANGE_THIS
AWS_SES_SMTP_PASSWORD=CHANGE_THIS

# Resend
RESEND_API_KEY=CHANGE_THIS
RESEND_FROM_EMAIL=notifications@byevastore.com
RESEND_FROM_NAME=Store Management

# Email Settings
ENABLE_EMAILS=true

# CORS - IMPORTANT: Inclure le domaine Vercel
CORS_ORIGIN=https://stock.sekuu.com,https://stock.byevastore.com,https://stockn.byevastore.com,https://new.byevastore.com

# Sync
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_STRATEGY=last-write-wins

# Sentry
SENTRY_DSN=CHANGE_THIS

# NotchPay Payment Gateway
NOTCHPAY_PUBLIC_KEY=CHANGE_THIS
NOTCHPAY_PRIVATE_KEY=CHANGE_THIS
NOTCHPAY_MODE=sandbox
NOTCHPAY_WEBHOOK_SECRET=your_webhook_secret_here
NOTCHPAY_DEFAULT_CURRENCY=XAF
