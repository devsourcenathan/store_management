// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MULTI-TENANCY & USERS
// ============================================

model Organization {
  id          String   @id @default(uuid())
  name        String
  address     String?
  phone       String?
  email       String?
  website     String?
  taxId       String? // NIF or equivalent
  logoUrl     String?
  footer      String? // Default footer for invoices
  themeConfig Json? // Theme colors and branding settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stores               Store[]
  users                User[]
  products             Product[]
  customers            Customer[]
  suppliers            Supplier[]
  services             Service[]
  auditLogs            AuditLog[]
  landingPage          OrganizationLanding?
  media                Media[]
  platformSubscription OrganizationSubscription?
  devices              Device[]
  rolePermissions      RolePermission[]

  @@map("organizations")
}

model Store {
  id             String   @id @default(uuid())
  name           String
  address        String?
  phone          String?
  email          String?
  logoUrl        String? // Override org logo
  receiptFooter  String? // Custom footer for store receipts
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements  StockMovement[]
  sales           Sale[]
  userStores      UserStore[]
  stockAlerts     StockAlert[]
  deletedProducts DeletedProduct[]

  @@map("stores")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  firstName            String
  lastName             String
  role                 UserRole
  organizationId       String
  isActive             Boolean   @default(true)
  locale               String    @default("fr") // 'en' or 'fr'

  // Email Notification Preferences
  emailNotificationsEnabled Boolean @default(true)
  dailyReportEnabled        Boolean @default(false)
  weeklyReportEnabled       Boolean @default(false)
  monthlyReportEnabled      Boolean @default(false)
  yearlyReportEnabled       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stores          UserStore[]
  auditLogs       AuditLog[]
  syncMetadata    SyncMetadata[]
  userPermissions UserPermission[]

  @@map("users")
}

enum UserRole {
  OWNER
  MANAGER
  STAFF
  GLOBAL_ADMIN
}

model UserStore {
  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@map("user_stores")
}

// ============================================
// PRODUCTS & CATEGORIES
// ============================================

model Product {
  id             String   @id @default(uuid())
  name           String
  sku            String
  description    String?
  categoryId     String?
  organizationId String
  basePrice      Decimal  @db.Decimal(10, 2)
  costPrice      Decimal  @default(0) @db.Decimal(10, 2)
  minStock       Int      @default(10)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category         Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  stockMovements   StockMovement[]
  stockAlerts      StockAlert[]
  saleItems        SaleItem[]
  supplyItems      SupplyItem[]
  pricingRules     PricingRule[]
  maintenanceParts MaintenancePart[]
  deletedInStores  DeletedProduct[]

  @@unique([organizationId, sku])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  filename  String
  url       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model DeletedProduct {
  id        String   @id @default(uuid())
  productId String
  storeId   String
  deletedAt DateTime @default(now())
  deletedBy String? // User ID who deleted the product
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([productId, storeId])
  @@map("deleted_products")
}

model Media {
  id           String  @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int // Size in bytes
  url          String // S3 URL
  thumbnailUrl String? // Optional thumbnail
  alt          String? // Alt text for accessibility

  // Polymorphic relations
  entityType MediaEntityType
  entityId   String

  // Organization scoping
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Metadata
  uploadedBy String
  isPublic   Boolean  @default(false)
  tags       String[] // For search and filtering

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, tags])
  @@map("media")
}

enum MediaEntityType {
  PRODUCT
  ORGANIZATION
  STORE
  LANDING_PAGE
  CATEGORY
  OTHER
  SERVICE
  OFFER
  USER
}

model Category {
  id             String   @id @default(uuid())
  name           String
  description    String?
  parentId       String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@map("categories")
}

model PricingRule {
  id        String   @id @default(uuid())
  productId String
  name      String
  rules     Json // Dynamic pricing rules in JSONB
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("pricing_rules")
}

// ============================================
// STOCK MANAGEMENT (APPEND-ONLY)
// ============================================

model StockMovement {
  id        String              @id @default(uuid())
  productId String
  storeId   String
  type      StockMovementType
  source    StockMovementSource
  quantity  Int
  reference String? // Reference to sale, supply, etc.
  notes     String?
  createdBy String
  createdAt DateTime            @default(now())
  syncedAt  DateTime?
  clientId  String? // For offline sync tracking

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId, storeId])
  @@index([createdAt])
  @@index([clientId])
  @@map("stock_movements")
}

enum StockMovementSource {
  SALE
  SUPPLY
  RETURN
  MANUAL
}

enum StockMovementType {
  IN
  OUT
  ADJUST
  RETURN
  SALE
  SUPPLY
  ADJUSTMENT
  TRANSFER_OUT // Product leaving source store
  TRANSFER_IN // Product arriving at destination store
}

model StockAlert {
  id             String    @id @default(uuid())
  productId      String
  storeId        String
  threshold      Int
  currentLevel   Int
  acknowledged   Boolean   @default(false)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, acknowledged])
  @@map("stock_alerts")
}

// ============================================
// SALES & PAYMENTS
// ============================================

model Sale {
  id          String     @id @default(uuid())
  storeId     String
  customerId  String?
  totalAmount Decimal    @db.Decimal(10, 2)
  paidAmount  Decimal    @default(0) @db.Decimal(10, 2)
  discount    Decimal    @default(0) @db.Decimal(10, 2)
  status      SaleStatus
  notes       String?
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  syncedAt    DateTime?
  clientId    String? // For offline sync

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]

  @@index([storeId, createdAt])
  @@index([customerId])
  @@index([clientId])
  @@map("sales")
}

enum SaleStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("sale_items")
}

model Payment {
  id        String        @id @default(uuid())
  saleId    String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  reference String?
  notes     String?
  createdBy String
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  CREDIT
  BANK_TRANSFER
}

// ============================================
// CUSTOMERS
// ============================================

model Customer {
  id             String   @id @default(uuid())
  name           String
  email          String?
  phone          String?
  address        String?
  creditLimit    Decimal  @default(0) @db.Decimal(10, 2)
  currentCredit  Decimal  @default(0) @db.Decimal(10, 2)
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales               Sale[]
  subscriptions       CustomerSubscription[]
  devices             Device[]
  maintenances        Maintenance[]
  maintenanceInvoices MaintenanceInvoice[]

  @@map("customers")
}

// ============================================
// SUPPLIERS & SUPPLIES
// ============================================

model Supplier {
  id             String   @id @default(uuid())
  name           String
  email          String?
  phone          String?
  address        String?
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplies       Supply[]
  balanceEntries SupplierBalanceEntry[]

  @@map("suppliers")
}

model Supply {
  id          String       @id @default(uuid())
  supplierId  String
  totalAmount Decimal      @db.Decimal(10, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(10, 2)
  status      SupplyStatus
  notes       String?
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  supplier Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items    SupplyItem[]

  @@map("supplies")
}

enum SupplyStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

model SupplyItem {
  id        String  @id @default(uuid())
  supplyId  String
  productId String
  quantity  Int
  unitCost  Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  supply  Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("supply_items")
}

model SupplierBalanceEntry {
  id         String           @id @default(uuid())
  supplierId String
  type       BalanceEntryType
  amount     Decimal          @db.Decimal(10, 2)
  reference  String? // Reference to supply, payment, etc.
  notes      String?
  createdBy  String
  createdAt  DateTime         @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, createdAt])
  @@map("supplier_balance_entries")
}

// ============================================
// SUBSCRIPTIONS
// ============================================

model Service {
  id             String   @id @default(uuid())
  name           String
  description    String?
  provider       String // Third-party service provider
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  offers       SubscriptionOffer[]
  accounts     SubscriptionAccount[]

  @@map("services")
}

model SubscriptionAccount {
  id        String   @id @default(uuid())
  serviceId String
  storeId   String
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service        Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  balanceEntries SubscriptionBalanceEntry[]
  alerts         SubscriptionBalanceAlert[]

  @@unique([serviceId, storeId])
  @@map("subscription_accounts")
}

model SubscriptionOffer {
  id           String   @id @default(uuid())
  serviceId    String
  name         String
  description  String?
  basePrice    Decimal  @db.Decimal(10, 2)
  duration     Int // Duration in days
  billingCycle String // MONTHLY, YEARLY, etc.
  pricingRules Json? // Dynamic pricing in JSONB
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  service       Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  options       SubscriptionOption[]
  subscriptions CustomerSubscription[]

  @@map("subscription_offers")
}

model SubscriptionOption {
  id           String  @id @default(uuid())
  offerId      String
  name         String
  description  String?
  price        Decimal @db.Decimal(10, 2)
  pricingRules Json? // Dynamic pricing rules
  isActive     Boolean @default(true)

  offer         SubscriptionOffer      @relation(fields: [offerId], references: [id], onDelete: Cascade)
  subscriptions CustomerSubscription[]

  @@map("subscription_options")
}

model CustomerSubscription {
  id         String             @id @default(uuid())
  customerId String
  offerId    String
  status     SubscriptionStatus
  startDate  DateTime
  endDate    DateTime?
  autoRenew  Boolean            @default(true)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  customer Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offer    SubscriptionOffer     @relation(fields: [offerId], references: [id], onDelete: Restrict)
  options  SubscriptionOption[] // Active options for this subscription
  renewals SubscriptionRenewal[]

  @@map("customer_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  EXPIRED
}

model SubscriptionBalanceEntry {
  id        String                    @id @default(uuid())
  accountId String
  type      BalanceEntryType
  source    SubscriptionBalanceSource
  amount    Decimal                   @db.Decimal(10, 2)
  reference String?
  notes     String?
  createdBy String
  createdAt DateTime                  @default(now())

  account SubscriptionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("subscription_balance_entries")
}

enum SubscriptionBalanceSource {
  INJECTION
  SUBSCRIPTION
  REFUND
  CORRECTION
}

enum BalanceEntryType {
  DEBIT
  CREDIT
}

model SubscriptionRenewal {
  id             String    @id @default(uuid())
  subscriptionId String
  duration       Int // Duration in days
  price          Decimal   @db.Decimal(10, 2)
  balanceUsed    Decimal   @db.Decimal(10, 2) // Amount deducted from balance account
  createdBy      String
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?
  clientId       String? // For offline sync tracking

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@index([clientId])
  @@map("subscription_renewals")
}

model SubscriptionBalanceAlert {
  id             String           @id @default(uuid())
  accountId      String
  type           BalanceAlertType
  threshold      Decimal?         @db.Decimal(10, 2)
  currentBalance Decimal          @db.Decimal(10, 2)
  resolved       Boolean          @default(false)
  resolvedBy     String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  account SubscriptionAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, resolved])
  @@map("subscription_balance_alerts")
}

enum BalanceAlertType {
  NEGATIVE
  LOW_BALANCE
}

// ============================================
// AUDIT & SYNC
// ============================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  action         String // CREATE, UPDATE, DELETE, LOGIN, EXPORT, etc.
  entity         String // Sale, Product, Maintenance, User, etc.
  entityId       String
  changes        Json? // Before/After for modifications
  method         String? // HTTP method: GET, POST, PUT, DELETE, PATCH
  status         String   @default("SUCCESS") // SUCCESS, FAILED, PARTIAL
  duration       Int? // Duration in milliseconds
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([status])
  @@map("audit_logs")
}

model SyncMetadata {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  lastPullAt DateTime?
  lastPushAt DateTime?
  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("sync_metadata")
}

// ============================================
// LANDING & ADMIN
// ============================================

model LandingContent {
  id           String   @id @default(uuid())
  heroTitle    String
  heroSubtitle String?
  ctaText      String?
  sections     Json? // Array of objects { title, content, image, etc. }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_content")
}

model OrganizationLanding {
  id             String  @id @default(uuid())
  organizationId String  @unique
  subdomain      String? @unique
  customDomain   String? @unique
  published      Boolean @default(false)

  sections    Json?
  themeConfig Json?

  // HTML/CSS/JS Import Support
  rawHtml    String?   @db.Text // Original HTML content
  rawCss     String?   @db.Text // Original CSS content
  rawJs      String?   @db.Text // Original JavaScript content
  importedAt DateTime? // When the site was imported
  editMode   String    @default("visual") // "visual" or "code"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_landing")
}

// ============================================
// PLATFORM BILLING & SUBSCRIPTIONS
// ============================================

enum PlatformPlanType {
  FREE
  PRO
  BUSINESS
}

enum BillingCycle {
  MONTHLY
  SEMI_ANNUAL
  ANNUAL
}

enum PlatformSubscriptionStatus {
  TRIALING
  ACTIVE
  LIFETIME
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model PlatformPlan {
  id              String           @id @default(uuid())
  name            String // "PRO", "BUSINESS"
  type            PlatformPlanType
  monthlyPrice    Decimal          @db.Decimal(10, 2)
  semiAnnualPrice Decimal          @db.Decimal(10, 2)
  annualPrice     Decimal          @db.Decimal(10, 2)
  // Limits (null = unlimited)
  maxStores       Int?
  maxProducts     Int?
  maxUsers        Int?
  features        Json? // Feature flags JSON
  trialDays       Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions OrganizationSubscription[]
  invoices      BillingInvoice[]

  @@map("platform_plans")
}

model OrganizationSubscription {
  id                 String                     @id @default(uuid())
  organizationId     String                     @unique
  planId             String
  status             PlatformSubscriptionStatus
  billingCycle       BillingCycle?
  isLifetime         Boolean                    @default(false)
  hideBillingUI      Boolean                    @default(false)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  cancelledAt        DateTime?
  assignedByAdmin    String?
  notchpayCustomerId String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         PlatformPlan     @relation(fields: [planId], references: [id])
  invoices     BillingInvoice[]

  @@map("organization_subscriptions")
}

model BillingInvoice {
  id             String        @id @default(uuid())
  subscriptionId String
  invoiceNumber  String        @unique
  amount         Decimal       @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  status         InvoiceStatus
  dueDate        DateTime
  paidAt         DateTime?
  notchpayRef    String?
  paymentUrl     String?
  createdAt      DateTime      @default(now())

  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // Optional plan snapshot for switching plans
  planId       String?
  plan         PlatformPlan?            @relation(fields: [planId], references: [id])

  @@index([subscriptionId, createdAt])
  @@map("billing_invoices")
}

// End of file

// ============================================
// MAINTENANCE & SAV
// ============================================

enum DeviceOwnerType {
  INTERNAL
  CLIENT
}

model Device {
  id             String          @id @default(uuid())
  name           String
  model          String?
  serialNumber   String?
  ownerType      DeviceOwnerType
  customerId     String?
  organizationId String
  storeId        String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  maintenances Maintenance[]

  @@index([organizationId, ownerType])
  @@index([customerId])
  @@map("devices")
}

enum MaintenanceStatus {
  PENDING
  IN_PROGRESS
  DONE
  CANCELLED
}

enum MaintenanceType {
  CLIENT
  INTERNAL
}

model Maintenance {
  id             String            @id @default(uuid())
  deviceId       String
  customerId     String?
  type           MaintenanceType
  status         MaintenanceStatus @default(PENDING)
  description    String
  diagnosis      String?
  laborCost      Decimal           @default(0) @db.Decimal(10, 2)
  totalCost      Decimal           @default(0) @db.Decimal(10, 2)
  storeId        String
  organizationId String
  createdBy      String
  completedBy    String?
  completedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  syncedAt       DateTime?
  clientId       String?

  device   Device              @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  customer Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  parts    MaintenancePart[]
  invoice  MaintenanceInvoice?

  @@index([storeId, status])
  @@index([deviceId])
  @@index([customerId])
  @@index([type, status])
  @@map("maintenances")
}

model MaintenancePart {
  id            String  @id @default(uuid())
  maintenanceId String
  productId     String
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("maintenance_parts")
}

enum MaintenanceInvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

model MaintenanceInvoice {
  id            String                   @id @default(uuid())
  maintenanceId String                   @unique
  customerId    String
  invoiceNumber String                   @unique
  amount        Decimal                  @db.Decimal(10, 2)
  status        MaintenanceInvoiceStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  maintenance Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("maintenance_invoices")
}

// ============================================
// PERMISSIONS SYSTEM
// ============================================

// Represents a resource/feature in the system
model Permission {
  id          String   @id @default(uuid())
  resource    String   @unique // e.g., "sales", "pos", "products", "settings"
  name        String // Display name
  description String?
  category    String // e.g., "commercial", "inventory", "finance"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

// Maps which roles have access to which resources (organization-level)
model RolePermission {
  id             String   @id @default(uuid())
  organizationId String
  role           UserRole // MANAGER or STAFF (OWNER always has full access)
  permissionId   String
  canAccess      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, role, permissionId])
  @@map("role_permissions")
}

// User-level permission overrides (takes precedence over role permissions)
model UserPermission {
  id           String   @id @default(uuid())
  userId       String
  permissionId String
  canAccess    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}
