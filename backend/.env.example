# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stock_management_prod?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AWS SES Region (Keep this for emails if using SES)
AWS_REGION=us-east-1

# Cloudflare R2 (Images)
CLOUDFLARE_R2_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=stock-management-images
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-domain.r2.dev

# Amazon SES (Email)
AWS_SES_SMTP_USERNAME=your-ses-smtp-username
AWS_SES_SMTP_PASSWORD=your-ses-smtp-password
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
AWS_SES_FROM_NAME=Stock Management System
ENABLE_EMAILS=false

# CORS
CORS_ORIGIN=http://localhost:5173

# Sync
SYNC_BATCH_SIZE=100
SYNC_CONFLICT_STRATEGY=last-write-wins
