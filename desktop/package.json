{
  "name": "stock-management-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare:bundle": "npm --prefix ../backend run desktop:build-seed-db && npm --prefix ../backend run build && npm --prefix ../frontend run build:desktop",
    "dist:zip": "npm run prepare:bundle && electron-builder --win zip --publish never"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.stockmanagement.local",
    "productName": "StockManagement",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "../backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "../backend/generated/sqlite-client",
        "to": "backend/generated/sqlite-client"
      },
      {
        "from": "../backend/generated/desktop-stock.db",
        "to": "backend/seed/desktop-stock.db"
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    }
  }
}